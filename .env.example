DATABASE_URL=sqlite://omfj.db
PORT=3000
SITE_URL=http://localhost:3000
RUST_LOG=omfj_no=debug,tower_http=debug


# How visitors are signed in:
#   none    - everyone is signed out (default)
#   tailnet - requests with an `X-Tailnet-User` header are signed in. Only use behind a
#             reverse proxy that strips the header and sets it for tailnet clients.
#   always  - everyone is signed in, for local development
AUTH=always
